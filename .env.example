# moav-client — deployment config (docker-compose).
#
# This file is the single source of truth for VERSIONS, host exposure, and the
# proxy PORTS. `config.yaml` owns VPN/app behaviour (endpoints, routing, sidecar
# enable/config). See docs/CONFIGURATION.md for the full boundary.
#
# Copy to .env (cp .env.example .env), or let the dashboard's Network tab manage
# the bind/auth lines via /api/exposure.

# ===========================================================================
# Exposure — which host addresses the proxy ports bind to
#   127.0.0.1 (default) — only this machine reaches the proxy
#   0.0.0.0             — every device on your LAN (or beyond, if forwarded)
# ===========================================================================
SOCKS5_BIND=127.0.0.1
HTTP_BIND=127.0.0.1
API_BIND=127.0.0.1
UI_BIND=127.0.0.1

# moav-client records the chosen exposure mode here so the dashboard renders the
# right control. One of: loopback | lan | public.
MOAV_EXPOSURE=loopback

# ===========================================================================
# Ports — the proxy-core listeners. These are the single source: proxy-core
# reads them (overriding config.yaml -> proxy.*_port) and docker-compose maps
# the same container ports. Change here, not in config.yaml.
# ===========================================================================
SOCKS5_PORT=1080
HTTP_PORT=8080
API_PORT=8088

# ===========================================================================
# Auth
#   SOCKS5_*        — optional SOCKS5 listener auth. Overrides config.yaml ->
#                     proxy.auth (the dashboard writes here). Recommended
#                     whenever SOCKS5_BIND is 0.0.0.0.
#   MOAV_DASHBOARD_* — dashboard + API basic auth (enforced by nginx and the
#                     API). Both must be set for auth to engage; /api/healthz
#                     stays open. Strongly recommended off localhost.
# ===========================================================================
# SOCKS5_USERNAME=
# SOCKS5_PASSWORD=
# MOAV_DASHBOARD_USER=admin
# MOAV_DASHBOARD_PASS=

# ===========================================================================
# Component versions — the single source of truth for every bundled component.
# Values track the MoaV server's .env.example. Change one and run
# `moav-client up` (or `docker compose up -d --build`) to rebuild just that
# piece. Built-from-source sidecars are passed as build args; pulled images use
# the tag below (override the whole ref with IMAGE_* to swap registries).
# ===========================================================================

# App version is the VERSION file (the `moav-client` wrapper exports it). Set
# this only to stamp a custom build tag.
# MOAV_VERSION=1.4.0

# sing-box — pulled image tag (ghcr.io/sagernet/sing-box:v${SINGBOX_VERSION}).
SINGBOX_VERSION=1.13.19

# Xray-core — https://github.com/XTLS/Xray-core/releases (built by sidecars/xray).
XRAY_VERSION=v26.7.28

# AmneziaWG — matched daemon + tools pair. https://github.com/amnezia-vpn.
AMNEZIAWG_GO_VERSION=v3.1.20260814
AWGTOOLS_VERSION=v3.1.20260812

# MasterDNS / MahsaNG client — https://github.com/masterking32/MasterDnsVPN.
MASTERDNS_VERSION=v2026.05.10.180256-27c7e11

# TrustTunnel client — https://github.com/TrustTunnel/TrustTunnelClient.
TRUSTTUNNEL_CLIENT_VERSION=v1.0.49

# Pulled images — override the whole ref (repo:tag) to pin or swap registries.
# IMAGE_SINGBOX=ghcr.io/sagernet/sing-box:v1.13.19
# IMAGE_TOR=peterdavehello/tor-socks-proxy:latest
# IMAGE_CADDY=caddy:2
